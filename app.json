{
  "expo": {
    "name": "IT Benefits",
    "slug": "Benefits",
    "privacy": "public",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-camera"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      ["expo-build-properties",
      {
        "android": {
          "compileSdkVersion": 34,
          "targetSdkVersion": 34,
          "buildToolsVersion": "34.0.0"
        },
        "ios": {
          "deploymentTarget": "13.4"
        }
      }]
    ],
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./src/assets/images/App-Icon-832x3x.png",
    "splash": {
      "image": "./src/assets/images/ITBenefitsLogo3x-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#F1F1F1"
    },
    "androidStatusBarColor": "#ffffff",
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.itBenefits",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "The app accesses your photos to let you share them with your friends.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone"
      }
    },
    "android": {
      "versionCode": 10,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.itbenefits"
    },
    "description": "Release version 1.1.0",
    "githubUrl": "https://github.com/ClusterBenefits/ClusterFront",
    "scheme": "exp"
  }
}
